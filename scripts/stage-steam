#!/usr/bin/env python3
"""stage-steam: put stage-run in front of every installed Steam game's launch
options, so each game gets the stage as its screen in streamer mode and runs
as before outside it (scripts/stage-run).

Usage: stage-steam            add stage-run to every game
       stage-steam --undo     take it back out
       stage-steam --dry-run  show what either would change, write nothing

Steam must be closed: it rewrites its config on exit and would drop the
change. Run it again after installing a game. Before writing, the config is
copied to localconfig.vdf.stage-steam.bak beside it.
"""

import glob
import os
import shutil
import subprocess
import sys

import vdf

CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
RUN = os.path.join(CONFIG, "hypr", "scripts", "stage-run")

# Steam's own tools, and VTube Studio: streaming kit, a window beside the
# stage, never on it.
SKIP_PREFIXES = ("Proton", "Steam Linux Runtime", "Steamworks Common")
SKIP_APPS = {"1325860"}


def die(msg):
    print(f"stage-steam: {msg}", file=sys.stderr)
    sys.exit(1)


# Steam escapes only backslash and quote; a tab in a value stays a raw tab.
def esc(s):
    return s.replace("\\", "\\\\").replace('"', '\\"')


def dump(d, level=0):
    ind = "\t" * level
    out = []
    for k, v in d.items():
        if isinstance(v, dict):
            out.append(f'{ind}"{esc(k)}"\n{ind}{{\n{dump(v, level + 1)}{ind}}}\n')
        else:
            out.append(f'{ind}"{esc(k)}"\t\t"{esc(v)}"\n')
    return "".join(out)


def installed(root):
    folders = vdf.load(open(os.path.join(root, "steamapps", "libraryfolders.vdf"), encoding="utf-8"))
    games = {}
    for lib in folders["libraryfolders"].values():
        for manifest in glob.glob(os.path.join(lib["path"], "steamapps", "appmanifest_*.acf")):
            app = vdf.load(open(manifest, encoding="utf-8"))["AppState"]
            if app["appid"] in SKIP_APPS or app["name"].startswith(SKIP_PREFIXES):
                continue
            games[app["appid"]] = app["name"]
    return games


def add(opts):
    if RUN in opts:
        return opts
    if not opts.strip():
        return f"{RUN} %command%"
    if "%command%" in opts:
        # After any VAR=value in front, so those reach the game too.
        return opts.replace("%command%", f"{RUN} %command%", 1)
    # Bare arguments are the game's: Steam appends them to the command.
    return f"{RUN} %command% {opts}"


def remove(opts):
    opts = opts.replace(f"{RUN} ", "")
    return "" if opts == "%command%" else opts


def main():
    args = set(sys.argv[1:])
    if args - {"--undo", "--dry-run"}:
        print(__doc__.strip())
        sys.exit(2)
    undo, dry = "--undo" in args, "--dry-run" in args

    if not dry and subprocess.run(["pgrep", "-x", "steam"], capture_output=True).returncode == 0:
        die("Steam is running. Quit it (Steam > Exit), then run this again.")
    if not undo and not os.access(RUN, os.X_OK):
        die(f"{RUN} is missing")

    root = os.path.realpath(os.path.expanduser("~/.steam/root"))
    games = installed(root)
    configs = glob.glob(os.path.join(root, "userdata", "*", "config", "localconfig.vdf"))
    if not configs:
        die(f"no localconfig.vdf under {root}/userdata")

    for path in configs:
        src = open(path, encoding="utf-8").read()
        data = vdf.loads(src, mapper=vdf.VDFDict)
        # Written back only if it reads back byte for byte as Steam wrote it.
        if dump(data) != src:
            die(f"{path}: not in the format this writes; left alone")

        steam = data["UserLocalConfigStore"]["Software"]["Valve"]["Steam"]
        key = next((k for k in steam.keys() if k.lower() == "apps"), None)
        if key is None:
            steam["apps"] = vdf.VDFDict()
            key = "apps"
        apps = steam[key]

        changed = 0
        for appid, name in sorted(games.items(), key=lambda g: g[1].lower()):
            if appid not in apps:
                if undo:
                    continue
                apps[appid] = vdf.VDFDict()
            before = apps[appid].get("LaunchOptions", "")
            after = remove(before) if undo else add(before)
            if after == before:
                continue
            changed += 1
            print(f"{name}: {before or '(none)'!r} -> {after or '(none)'!r}")
            # A plain key on a VDFDict appends a duplicate; (0, key) replaces.
            if "LaunchOptions" in apps[appid]:
                apps[appid][(0, "LaunchOptions")] = after
            else:
                apps[appid]["LaunchOptions"] = after

        if dry or not changed:
            print(f"{path}: {changed} to change" + (", dry run" if dry and changed else ""))
            continue
        shutil.copy2(path, path + ".stage-steam.bak")
        with open(path, "w", encoding="utf-8") as f:
            f.write(dump(data))
        print(f"{path}: {changed} changed, backup at {path}.stage-steam.bak")


if __name__ == "__main__":
    main()
