#!/usr/bin/env bash
# stage-run: in streamer mode, give a game the stage as its whole screen.
# Set it once per game as the Steam launch option:
#
#     /home/bandit/.config/hypr/scripts/stage-run %command%
#
# A game sizes itself to the monitor it sees, and here that is the 32:9
# ultrawide; squeezed into the 16:9 stage it renders half off the edge.
# Hyprland cannot cut a monitor into smaller displays, so the game runs inside
# gamescope instead: a display the stage's size and refresh rate, in which its
# own fullscreen fills exactly the stage. gamescope's window is Wayland and
# asks for fullscreen, which on a stage workspace means the stage
# (lua/stage.lua); lua/rules.lua sends it to workspace 3.
#
# Outside streamer mode, or with no stage to size it to, the game runs as is.

set -euo pipefail

here=$(dirname "$(readlink -f "$0")")
# lua/mode.lua builds the same path.
streamer_file="${XDG_STATE_HOME:-$HOME/.local/state}/hypr/streamer"

if [[ -e "$streamer_file" ]] && command -v gamescope >/dev/null &&
    read -r _ _ w h < <("$here/hypr-mode" stage 2>/dev/null); then
    hz=$(hyprctl -j monitors | jq -r --arg n "$HYPR_STAGE" \
        'map(select(.name == $n))[0].refreshRate // 60 | round')
    # Steam preloads its overlay into what it launches. It belongs in the
    # game; inside gamescope itself it stalls frames.
    preload=${LD_PRELOAD:-}
    LD_PRELOAD="" exec gamescope -W "$w" -H "$h" -w "$w" -h "$h" -r "$hz" -f \
        -- env LD_PRELOAD="$preload" "$@"
fi

exec "$@"
